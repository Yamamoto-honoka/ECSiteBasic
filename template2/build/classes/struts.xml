<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.3//EN"
"http://struts.apache.org/dtds/struts-2.3.dtd">
<struts>
	<constant name = "struts.devMode" value= "true"/>
	<package name = "com.diworksdev.template2.action" extends = "struts-default">
	
		<action name = "HomeAction"
		class = "com.diworksdev.template2.action.HomeAction"
		method = "execute">
			<result name = "success">login.jsp</result>
		</action>
		
		<action name = "LoginAction"
		class = "com.diworksdev.template2.action.LoginAction"
		method = "execute">
			<result name = "success">buyItem.jsp</result>
			<result name = "error">home.jsp</result>
		</action>
		
		<action name="UserCreateAction"
		class = "com.diworksdev.template2.action.UserCreateAction"
		method = "execute">
			<result name = "success">userCreate.jsp</result>
		</action>
		
		<action name = "UserCreateConfirmAction"
		class = "com.diworksdev.template2.action.UserCreateConfirmAction"
		method = "execute">
			<result name = "success">userCreateConfirm.jsp</result>
			<result name = "error">userCreate.jsp</result>
		</action>
		
		<action name= "UserCreateCompleteAction"
		class = "com.diworksdev.template2.action.UserCreateCompleteAction"
		method = "execute">
			<result name = "success">userCreateComplete.jsp</result>
		</action>
	</package>
</struts>